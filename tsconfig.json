{
  // ============================================================
  // FIX TEAM — إعدادات فحص TypeScript (npm run check)
  // 🧸 ده «المدرّس» اللي بيصحّح الكراسة. مابيغيّرش ولا حرف في
  //    الموقع — بيقولك بس فين الغلط.
  // ⚠️ بيفحص فولدر ts/ بس. الحاجات اللي لسه في ملفات JS القديمة
  //    متعرّفة في ts/legacy-globals.d.ts.
  // ============================================================
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["ts/**/*.ts"],
  // 📄 كود الصفحات (ts/pages/) بيتفحص كل صفحة لوحدها — check-pages.mjs
  //    (كل صفحة «أوضة» لوحدها في المتصفح، فممكن يبقى فيها أسامي زي صفحة تانية)
  "exclude": ["ts/pages/**"]
}
